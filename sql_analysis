/*========================================================================
  TELCO CUSTOMER CHURN ANALYSIS
  ========================================================================

  Dataset  : Telco Customer Churn
  Source   : IBM Sample Dataset / Kaggle
  Database : Telco_Churn
  Table    : Dataset_Telco_churn

  OBJECTIF
  ----------
Identifier les principaux facteurs associés au taux de désabonnement des clients
et déterminer un segment de clientèle pouvant être priorisé dans le cadre 
des actions de fidélisation.

  ANALYSIS APPROACH
  -----------------
  1. Churn overview
  2. Contract analysis
  3. Tenure analysis
  4. Monthly charges analysis
  5. Internet service analysis
  6. Technical support analysis
  7. Segment identification
  8. Revenue exposure
  9. Additional analysis: payment method

  NOTE
  ----
  L’analyse met en évidence des associations entre les caractéristiques des clients
  et le taux de churn. Elle n’établit toutefois pas de lien de causalité.
===========================================================================*/

create database Telco_Churn

USE Telco_Churn;

select top 5 * from Telco_Churn.dbo.Dataset_Telco_churn;

/*========================================================
  1. CHURN OVERVIEW
  Vue d'ensemble du churn
========================================================*/

--Total Customers 
                                   
select count(distinct customerID )
from Telco_Churn.dbo.Dataset_Telco_churn;

--Number of churned customers

SELECT 
    SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) AS nb_churn
FROM Dataset_Telco_churn;

-- Overall churn rate
SELECT 
concat(cast(sum(case when Churn='Yes' then 1 ELSE 0 END)*100.0
 /count(distinct customerID) 
 as decimal(10,2)),'%')  as churn_percentage
from Dataset_Telco_churn;

/*========================================================
  2. CONTRACT ANALYSIS
  Analyse du type de contrat
========================================================*/

--Contract Analysis

select Contract,
	  COUNT(DISTINCT customerID) as nb_contract,
	  cast(sum(case when Churn ='Yes' then 1 else 0 END)*100.0/count(distinct customerID) as decimal(10,2)) as churn_pct
from Dataset_Telco_churn
group by Contract;
--> Le type de contrat est fortement associé au taux de churn. Les clients en contrat mensuel présentent un taux de churn nettement supérieur aux clients engagés sur un ou deux ans.

 
/*========================================================
  3. TENURE ANALYSIS
  Analyse de l'ancienneté
========================================================*/

--Churn by tenure
WITH tenure_segmentation AS (
    SELECT 
        customerID,
        Churn,
        CASE 
            WHEN tenure <= 6 THEN '0 à 6 mois'
            WHEN tenure <= 12 THEN '7 à 12 mois'
            WHEN tenure <= 24 THEN '13 à 24 mois'
            WHEN tenure <= 48 THEN '25 à 48 mois'
            ELSE '49 mois et +'
        END AS tenure_group,
        CASE 
            WHEN tenure <= 6 THEN 1
            WHEN tenure <= 12 THEN 2
            WHEN tenure <= 24 THEN 3
            WHEN tenure <= 48 THEN 4
            ELSE 5
        END AS ordre
    FROM Dataset_Telco_churn
)

SELECT 
    tenure_group,
    COUNT(*) AS nb_clients,
    CAST(
        SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) * 100.0 
        / COUNT(*)
        AS DECIMAL(10,2)
    ) AS churn_pct
FROM tenure_segmentation
GROUP BY tenure_group, ordre
ORDER BY ordre;
--> Le taux de churn diminue fortement avec l'ancienneté : les clients les plus récents présentent un taux de churn plus élevé, tandis que le churn diminue progressivement avec l'ancienneté. Cette baisse devient particulièrement marquée à partir de 13 à 24 mois.


--Contract by tenure

WITH tenure_segmentation AS (
