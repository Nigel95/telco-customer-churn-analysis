--> La relation entre ancienneté et churn varie fortement selon le type de contrat. Elle est particulièrement marquée chez les clients en contrat mensuel, tandis que le churn reste relativement faible et stable pour les contrats d'un an et de deux ans.


--- Contract_distribution × Tenure
---  Type de contrat et ancienneté


-- CTE 1 : à chaque client on attribut juste un groupe d'ancienneté.
WITH tenure_segmentation AS (
    SELECT 
	    customerID,
	    Contract,
        CASE 
            WHEN tenure <= 6 THEN '0 à 6 mois'
            WHEN tenure <= 12 THEN '7 à 12 mois'
            WHEN tenure <= 24 THEN '13 à 24 mois'
            WHEN tenure <= 48 THEN '25 à 48 mois'
            ELSE '49 mois et +'
        END AS tenure_group,
		  CASE 
          WHEN tenure <= 6 THEN 1
            WHEN tenure <= 12 THEN 2
            WHEN tenure <= 24 THEN 3
            WHEN tenure <= 48 THEN 4
            ELSE 5
        END AS ordre
    FROM Dataset_Telco_churn
)
-- CTE 2 : le nb de clients pour chaque combinaison ancienneté + contrat
 ,contract_counts AS (
    SELECT 
        tenure_group,
        contract,
        ordre,
        COUNT(DISTINCT customerID) AS nb_clients
    FROM tenure_segmentation
    GROUP BY tenure_group, contract, ordre)
--> Pour chaque groupe d'ancienneté, on additionne les clients de tous les contrats, mais conserve chaque ligne de contrat, et on calcule le pourcentage
SELECT 
    tenure_group,
    contract,
    nb_clients,
    SUM(nb_clients) OVER(PARTITION BY tenure_group) AS total_groupe,--sum(nb_clients) over(partition by tenure_group) pour chaque groupe ancienneté, additionne tous les nb_clients et conserve chaque ligne.
    CAST(
        nb_clients * 100.0 
        / SUM(nb_clients) OVER(PARTITION BY tenure_group)
        AS DECIMAL(5,2) -- pour obtenir le pourcentage du groupe
    ) AS pct_group
FROM contract_counts
ORDER BY ordre, contract;
--> Les nouveaux clients sont très majoritairement en contrat mensuel, et les nouveaux clients en contrat mensuel présentent un taux de churn particulièrement élevé.[Nouveaux clients(0 à 6 mois) --> 95.41% en Month to Month--> 55.2% de churn

/*=======================================================
  4. MONTHLY CHARGES ANALYSIS
  Analyse de la facturation mensuelle
========================================================*/
--Vérifier s'il y a des variables non convertibles en décimales dans la colonne MonthlyCharges (Data Quality check)
select MonthlyCharges
from Dataset_Telco_churn
where TRY_CAST(MonthlyCharges as decimal(10,2)) is null;

--Churn by MonthlyCharges
WITH MonthCharges_clean as(
        SELECT 
	    customerID,
		Churn,
		cast(MonthlyCharges as decimal (10,2)) as MonthlyCharges
		FROM Dataset_Telco_Churn),

MonthlyCharges_segmentation AS (
    SELECT 
	    customerID,
		Churn,
     CASE 
		WHEN MonthlyCharges <= 30 THEN '0 à 30 €'
		WHEN MonthlyCharges  <= 50 THEN '30 à 50 €'
		WHEN MonthlyCharges <= 70 THEN '50 à 70 €'
		WHEN MonthlyCharges <= 89 THEN '70 à 89 €'
		ELSE '90 € et +'
	END AS monthcharges_group,
     CASE 
		WHEN MonthlyCharges <= 30 THEN 1
		WHEN MonthlyCharges <= 50 THEN 2
		WHEN MonthlyCharges <= 70 THEN 3
		WHEN MonthlyCharges <= 89 THEN 4
		ELSE 5
		END as ordre_group
		FROM MonthCHarges_clean)

	Select monthcharges_group,
	count(distinct customerID) as nb_clients,
	cast(sum(case when Churn ='Yes' then 1 else 0 END) * 100.0 / count(*) as decimal (10,2)) as churn_pct
	from MonthlyCharges_segmentation
	group by monthcharges_group,ordre_group
	order by ordre_group;

--> MonthlyCharges a été identifié comme une colonne de type VARCHAR malgré sa nature numérique. Une conversion en DECIMAL(10,2) a donc été appliquée dans une couche de nettoyage avant les analyses?


--MonthlyCharges × Contract
--Objectif : vérifier si l'association entre facturation mensuelle et churn varie selon le type de contrat.


WITH MonthCharges_clean as(
        SELECT 
		Churn,
		Contract,
		cast(MonthlyCharges as decimal (10,2)) as MonthlyCharges
		FROM Dataset_Telco_Churn),

MonthlyCharges_segmentation AS (
    SELECT 
		Churn,
		Contract,
     CASE 
		WHEN MonthlyCharges <= 30 THEN '0 à 30 €'
		WHEN MonthlyCharges  <= 50 THEN '30 à 50 €'
		WHEN MonthlyCharges <= 70 THEN '50 à 70 €'
		WHEN MonthlyCharges <= 89 THEN '70 à 89 €'
		ELSE '90 € et +'
	END AS monthcharges_group,
     CASE 
		WHEN MonthlyCharges <= 30 THEN 1
		WHEN MonthlyCharges <= 50 THEN 2
		WHEN MonthlyCharges <= 70 THEN 3
		WHEN MonthlyCharges <= 89 THEN 4
		ELSE 5
		END as ordre_group
