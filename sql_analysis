/*========================================================
  5. INTERNET SERVICE ANALYSIS
  Analyse du service Internet
========================================================*/
-- InternetService x Churn
	Select InternetService,
	cast(sum(case when Churn ='Yes' then 1 else 0 END) * 100.0 / count(InternetService) as decimal (10,2)) as churn_pct
	from Dataset_Telco_churn
	group by InternetService; --Les clients disposant d'une connexion Fiber optic présentent un taux de churn nettement supérieur aux clients DSL ou aux clients sans service Internet.


-- InternetService x Contract
	Select Contract,
	internetservice,
	cast(sum(case when Churn ='Yes' then 1 else 0 END) * 100.0 / count(*) as decimal (10,2)) as churn_pct
	from Dataset_Telco_churn
	group by contract, InternetService
	order by contract; --le contrat Month-to-month reste associé au churn élevé quel que soit le type de connexion.


	
/*====================================================
6. TECHNICAL SUPPORT ANALYSIS
Objectif :les clients sans dispositif de services de support
ou de sécurité ont ils un churn plus élevé?
===========================================================*/

--Taux de churn et Tech support
	Select
	TechSupport,
	cast(sum(case when Churn ='Yes' then 1 else 0 END) * 100.0 / count(*) as decimal (10,2)) as churn_pct
	from Dataset_Telco_churn
	group by TechSupport; 
--> L'absence de support technique est fortement associée au churn : les clients disposant d'un service Internet mais sans support technique présentent un taux de churn de 41,64 %, contre 15,17 % pour ceux bénéficiant du support.

--Techsupport x contract 
	Select
	contract,
	TechSupport,
	cast(sum(case when Churn ='Yes' then 1 else 0 END) * 100.0 / count(*) as decimal (10,2)) as churn_pct
	from Dataset_Telco_churn
	group by contract,TechSupport
	order by contract;
--> L'association entre support technique et churn semble particulièrement forte chez les clients Month-to-month, alors qu'elle est beaucoup plus faible chez les clients engagés sur un an ou deux ans


--InternetService × TechSupport → Churn

	Select
	InternetService,
	TechSupport,
	cast(sum(case when Churn ='Yes' then 1 else 0 END) * 100.0 / count(*) as decimal (10,2)) as churn_pct
	from Dataset_Telco_churn
	group by InternetService,TechSupport
	order by InternetService;
--> L'absence de support technique est associée à un churn plus élevé, aussi bien chez les clients DSL que Fiber optic.

/*===========================================================
7. SEGMENT IDENTIFICATION
Month to Month x Fiber Optic x No technique
Identification d'un segment particulièrement exposé au churn
============================================================*/

--Segment prioritaire
select
Contract,
count(distinct customerid) as nb_client_segment,
InternetService,
Techsupport,
cast(sum(case when Churn ='Yes' then 1 else 0 END) * 100.0 / count(*) as decimal (10,2)) as churn_pct
from Dataset_Telco_churn
where contract = 'Month-to-month' and InternetService ='Fiber optic' and TechSupport = 'No'
group by Contract,InternetService,techsupport
order by contract;
--> Les clients cumulant les trois caractéristiques Month-to-month + Fiber optic + absence de support technique présentent un taux de churn de 57,52 %.

/*============================================
8. REVENUE EXPOSURE
["Month to Month" x "Fiber Optic" x "No tech support"]
=============================================*/

-- Nb de personne ayant churnés pour le segment
SELECT
    COUNT(distinct customerID) AS nb_clients,
    SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) AS nb_churn,
    CAST(
        SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) * 100.0
        / COUNT(distinct customerID)
        AS DECIMAL(10,2)
    ) AS churn_pct
FROM Dataset_Telco_churn
WHERE Contract = 'Month-to-month'
  AND InternetService = 'Fiber optic'
  AND TechSupport = 'No';

--> 1033 clients ont churnés sur 1796 clients sur ce segment 


--Valeur mensuelles totales des clients qui ont churné (Exposition Financière)

SELECT
    COUNT(distinct customerID) AS nb_clients,
    SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) AS nb_churn,
	sum(CASE WHEN Churn = 'Yes' then cast(MonthlyCharges as decimal (5,2)) ELSE 0 END) AS facturation_month_churn,
    CAST(
        SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) * 100.0
        / COUNT(customerID)
        AS DECIMAL(10,2)
    ) AS churn_pct
FROM Dataset_Telco_churn
WHERE Contract = 'Month-to-month'
  AND InternetService = 'Fiber optic'
  AND TechSupport = 'No';

--> 88165 € de facturation mensuelle totale associée au churn pour les clients de ce segment (Month to month , fiber optic, no tech support)


---Le poids de notre segment dans le churn total

SELECT
    SUM(CASE 
            WHEN Churn = 'Yes' 
            THEN 1 
            ELSE 0 
        END) AS nb_churn_tot,

    SUM(CASE 
            WHEN Churn = 'Yes'
             AND Contract = 'Month-to-month'
             AND InternetService = 'Fiber optic'
             AND TechSupport = 'No'
            THEN 1
            ELSE 0
        END) AS nb_churn_segmt,

    CAST(
        SUM(CASE 
                WHEN Churn = 'Yes'
                 AND Contract = 'Month-to-month'
                 AND InternetService = 'Fiber optic'
                 AND TechSupport = 'No'
                THEN 1
                ELSE 0
            END) * 100.0
        /
        SUM(CASE 
                WHEN Churn = 'Yes'
                THEN 1
                ELSE 0
            END)
        AS DECIMAL(10,2)
    ) AS prop_churn_segmt

FROM Dataset_Telco_churn;

--> Résultat : 55.27%, plus de la moitié de tous les churners provienent de ce seul segment

